# Public project settings — safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only secrets — NEVER use the NEXT_PUBLIC_ prefix
OPENAI_API_KEY=YOUR_AI_PROVIDER_KEY
# Optional: base URL for a provider implementing the OpenAI Chat Completions API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
